      "name": "Check signature, build row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        0
      ],
      "parameters": {
        "jsCode": "// Only events signed with the shared secret (WEBHOOK_SECRET in the app, CROSSCHECK_WEBHOOK_SECRET here) get through.\nconst crypto = require('crypto');\nconst secret = $env.CROSSCHECK_WEBHOOK_SECRET;\nif (!secret) throw new Error('CROSSCHECK_WEBHOOK_SECRET is not set. Start n8n with start-n8n.cmd.');\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst sig = String($input.first().json.headers['x-signature'] || '');\nconst want = 'sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex');\nif (sig.length !== want.length || !crypto.timingSafeEqual(Buffer.from(sig), Buffer.from(want))) {\n  throw new Error('Bad signature. Event ignored.');\n}\nconst e = JSON.parse(raw.toString('utf8'));\nconst updated = new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Dhaka' }); // 2026-10-01 18:50:14, Dhaka time\n// a deleted document keeps its row; only the status changes\nif (e.event === 'document.deleted') return [{ json: { id: e.id, status: 'deleted', updated } }];\nconst d = e.document || {};\nreturn [{ json: {\n  id: e.id, file: e.file_name, status: e.status, vendor: d.vendor ?? '', date: d.issue_date ?? '',\n  currency: d.currency ?? '', subtotal: d.subtotal ?? '', tax: d.tax ?? '', total: d.total ?? '',\n  items: (d.items || []).length, checks: (e.checks || []).map((c) => c.message).join(' | '), updated,\n} }];"
      }
    },
